# Copy this file to .env and replace the placeholder values.
# NEVER commit the actual .env file to version control.
# app.config.js reads these variables and exposes them via expo-constants.

# Supabase project (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Skin lesion scoring API (FastAPI backend, see scoring-api/)
SCORING_API_URL=http://localhost:4000
